# Gradium (required). Server-side only — never exposed to the browser.
GRADIUM_API_KEY=
# Gradium cluster used for both token minting and WebSocket connections.
# One of: eu | us. Leave unset to infer from VERCEL_REGION (US default).
# Set this to pin the cluster, e.g. GRADIUM_REGION=eu.
GRADIUM_REGION=

# LLM provider for the counterpart + coaching report.
# One of: openrouter | openai | groq | anthropic
# The key can also be supplied via the provider-specific variable
# (OPENROUTER_API_KEY, OPENAI_API_KEY, GROQ_API_KEY, ANTHROPIC_API_KEY).
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Model id. Defaults to minimax/minimax-m3.1-flash:free (free).
LLM_MODEL=minimax/minimax-m3.1-flash:free
# Optional override for OpenAI-compatible providers / proxies. Leave blank for
# the provider default (OpenRouter -> https://openrouter.ai/api/v1).
LLM_BASE_URL=
